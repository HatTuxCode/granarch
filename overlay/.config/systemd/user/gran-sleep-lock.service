[Unit]
Description=Secure the Gran lock screen before suspend
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=GRAN_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/share/gran/bin/gran-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
