    "icon": "",
    "label": "Capture",
    "aliases": [
      "capture",
      "screenshot",
      "screenrecord",
      "screen-record",
      "screenrecording"
    ]
  },
  "trigger.capture.screenshot": {
    "icon": "",
    "label": "Screenshot",
    "action": "gran-capture-screenshot"
  },
  "trigger.capture.screenrecord.stop": {
    "icon": "",
    "label": "Stop Screenrecording",
    "when": "gran-capture-screenrecording --status",
    "action": "gran-capture-screenrecording --stop-recording"
  },
  "trigger.capture.screenrecord": {
    "icon": "",
    "label": "Screenrecord"
  },
