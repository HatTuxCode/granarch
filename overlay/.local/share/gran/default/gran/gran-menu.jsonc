    "icon": "󱓻",
    "label": "Tiling",
    "checked": "[[ $(gran-hyprland-workspace-layout-default) == \"dwindle\" ]]",
    "action": "gran-hyprland-workspace-layout-default dwindle"
  },
  "appearance.workspace-layout.scrolling": {
