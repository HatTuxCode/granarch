  },
  "trigger": {
    "icon": "󱓞",
    "label": "Trigger"
  },
  "setup": {
    "label": "Setup",
    "icon": "",
    "aliases": [
      "settings"
    ]
  },
  "update": {
    "icon": "",
    "label": "Update",
    "aliases": [
      "restart",
      "refresh"
    ]
  },
  "about": {
    "label": "About Gran",
    "action": "gran-launch-about",
    "icon": ""
  },
  "system": {
    "icon": "",
    "label": "System",
    "aliases": [
      "power-menu"
    ]
  },
  "system.screensaver": {
    "icon": "󱄄",
    "label": "Screensaver",
    "action": "gran-launch-screensaver force"
  },
  "system.lock": {
    "icon": "",
    "label": "Lock",
    "action": "gran-system-lock"
  },
  "system.suspend": {
    "icon": "󰒲",
    "label": "Suspend",
    "when": "! gran-toggle-enabled suspend-off && ! gran-sleep-disabled",
    "action": "systemctl suspend"
  },
  "system.hibernate": {
    "icon": "󰤁",
    "label": "Hibernate",
    "when": "gran-hibernation-available && ! gran-sleep-disabled",
    "action": "systemctl hibernate"
  },
  "system.logout": {
    "icon": "󰍃",
    "label": "Logout",
    "action": "gran-system logout"
  },
  "system.reboot": {
    "icon": "󰜉",
    "label": "Reboot",
    "action": "gran-system reboot"
  },
  "system.shutdown": {
    "icon": "󰐥",
    "label": "Shutdown",
    "action": "gran-system shutdown"
  },
  "learn.keybindings": {
    "icon": "",
    "label": "Keybindings",
    "action": "gran-menu-keybindings"
  },
  "learn.hyprland": {
    "icon": "",
    "label": "Hyprland",
    "action": "gran-launch-browser 'https://wiki.hypr.land/'"
  },
  "learn.arch": {
    "icon": "󰣇",
    "label": "Arch",
    "action": "gran-launch-browser 'https://wiki.archlinux.org/title/Main_page'"
  },
  "learn.neovim": {
    "icon": "",
    "label": "Neovim",
    "action": "gran-launch-browser 'https://www.lazyvim.org/keymaps'"
  },
  "learn.bash": {
    "icon": "󱆃",
    "label": "Bash",
    "action": "gran-launch-browser 'https://devhints.io/bash'"
  },
  "learn.tmux-keybindings": {
    "icon": "",
    "label": "Tmux",
    "action": "gran-menu-tmux-keybindings"
  },
  "learn.herdr-keybindings": {
    "icon": "",
    "label": "Herdr",
    "action": "gran-menu-herdr-keybindings"
  },
  "appearance.theme": {
    "icon": "󰸌",
    "label": "Theme",
    "aliases": [
      "theme",
      "themes"
    ],
    "action": "gran-shell shell summon gran.image-picker '{\"source\":\"themes\"}'"
  },
  "appearance.background": {
    "label": "Background",
    "action": "gran-theme-bg-persist",
    "aliases": [
      "background",
      "wallpaper"
    ]
  },
  "appearance.font": {
    "icon": "",
    "label": "Font",
    "provider": "fonts"
  },
  "appearance.top-bar": {
    "icon": "󰍜",
    "label": "Menu Bar"
  },
  "appearance.top-bar.hide": {
    "icon": "󰈉",
    "label": "Hide Bar",
    "when": "! gran-toggle-enabled bar-off",
    "action": "gran-toggle-bar"
  },
  "appearance.top-bar.show": {
    "icon": "󰈈",
    "label": "Show Bar",
    "when": "gran-toggle-enabled bar-off",
    "action": "gran-toggle-bar"
  },
  "appearance.top-bar.position": {
    "icon": "",
    "label": "Position Bar"
  },
  "appearance.top-bar.background": {
    "icon": "󰂵",
    "label": "Bar Background"
  },
  "appearance.top-bar.background.opaque": {
    "icon": "󰝤",
    "label": "Opaque Bar",
    "checked": "[[ $(gran-bar background) == \"opaque\" ]]",
    "action": "gran-bar background opaque"
  },
  "appearance.top-bar.background.glassy": {
    "icon": "󰂵",
    "label": "Glassy Bar",
    "checked": "[[ $(gran-bar background) == \"glassy\" ]]",
    "action": "gran-bar background glassy"
  },
  "appearance.top-bar.background.clear": {
    "icon": "󰝣",
    "label": "Clear Bar",
    "checked": "[[ $(gran-bar background) == \"none\" ]]",
    "action": "gran-bar background none"
  },
  "appearance.top-bar.indicators": {
    "icon": "󰋽",
    "label": "Bar Indicators"
  },
  "appearance.top-bar.indicators.battery-percentage-on": {
    "icon": "󰁹",
    "label": "Show Battery %",
    "when": "gran-hw-laptop && [[ $(gran-bar get gran.power showPercentage) != true ]]",
    "action": "gran-shell gran.power togglePercentage"
  },
  "appearance.top-bar.indicators.battery-percentage-off": {
    "icon": "󰁹",
    "label": "Hide Battery %",
    "when": "gran-hw-laptop && [[ $(gran-bar get gran.power showPercentage) == true ]]",
    "action": "gran-shell gran.power togglePercentage"
  },
  "appearance.top-bar.indicators.clock": {
    "icon": "󰥔",
    "label": "Clock"
  },
  "appearance.top-bar.indicators.clock.sunday-24h": {
    "icon": "󰥔",
    "label": "Sunday 14:30",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"dddd HH:mm\" ]]",
    "action": "gran-bar set gran.clock format \"dddd HH:mm\""
  },
  "appearance.top-bar.indicators.clock.sunday-12h": {
    "icon": "󰥔",
    "label": "Sunday 2:30 PM",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"dddd h:mm AP\" ]]",
    "action": "gran-bar set gran.clock format \"dddd h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {
    "icon": "󰥔",
    "label": "Sunday 14:30:05",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"dddd HH:mm:ss\" ]]",
    "action": "gran-bar set gran.clock format \"dddd HH:mm:ss\""
  },
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {
    "icon": "󰥔",
    "label": "Sunday 2:30:05 PM",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"dddd h:mm:ss AP\" ]]",
    "action": "gran-bar set gran.clock format \"dddd h:mm:ss AP\""
  },
  "appearance.top-bar.indicators.clock.time-24h": {
    "icon": "󰥔",
    "label": "14:30",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"HH:mm\" ]]",
    "action": "gran-bar set gran.clock format \"HH:mm\""
  },
  "appearance.top-bar.indicators.clock.time-12h": {
    "icon": "󰥔",
    "label": "2:30 PM",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"h:mm AP\" ]]",
    "action": "gran-bar set gran.clock format \"h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.date-24h": {
    "icon": "󰥔",
    "label": "Sun 3 May 14:30",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"ddd d MMM HH:mm\" ]]",
    "action": "gran-bar set gran.clock format \"ddd d MMM HH:mm\""
  },
  "appearance.top-bar.indicators.clock.date-12h": {
    "icon": "󰥔",
    "label": "Sun 3 May 2:30 PM",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"ddd d MMM h:mm AP\" ]]",
    "action": "gran-bar set gran.clock format \"ddd d MMM h:mm AP\""
  },
  "appearance.top-bar.indicators.clock.week": {
    "icon": "󰥔",
    "label": "3 May W18 2026",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"d MMMM 'W'ww yyyy\" ]]",
    "action": "gran-bar set gran.clock format \"d MMMM 'W'ww yyyy\""
  },
  "appearance.top-bar.indicators.clock.iso": {
    "icon": "󰥔",
    "label": "2026-05-03 14:30",
    "when": "[[ $(gran-bar position) != \"left\" && $(gran-bar position) != \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock format) == \"yyyy-MM-dd HH:mm\" ]]",
    "action": "gran-bar set gran.clock format \"yyyy-MM-dd HH:mm\""
  },
  "appearance.top-bar.indicators.clock.stacked-24h": {
    "icon": "󰥔",
    "label": "14 — 30",
    "when": "[[ $(gran-bar position) == \"left\" || $(gran-bar position) == \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock verticalFormat) == $'HH\\n—\\nmm' ]]",
    "action": "gran-bar set gran.clock verticalFormat $'HH\\n—\\nmm'"
  },
  "appearance.top-bar.indicators.clock.stacked-12h": {
    "icon": "󰥔",
    "label": "2 — 30 PM",
    "when": "[[ $(gran-bar position) == \"left\" || $(gran-bar position) == \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]",
    "action": "gran-bar set gran.clock verticalFormat $'h\\n—\\nmm\\nAP'"
  },
  "appearance.top-bar.indicators.clock.stacked-date": {
    "icon": "󰥔",
    "label": "03 May W18 '26",
    "when": "[[ $(gran-bar position) == \"left\" || $(gran-bar position) == \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]",
    "action": "gran-bar set gran.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"
  },
  "appearance.top-bar.indicators.clock.stacked-time": {
    "icon": "󰥔",
    "label": "14 30",
    "when": "[[ $(gran-bar position) == \"left\" || $(gran-bar position) == \"right\" ]]",
    "checked": "[[ $(gran-bar get gran.clock verticalFormat) == $'HH\\nmm' ]]",
    "action": "gran-bar set gran.clock verticalFormat $'HH\\nmm'"
  },
  "appearance.top-bar.position.top": {
    "icon": "󰁝",
    "label": "Top Bar",
    "action": "gran-bar position top"
  },
  "appearance.top-bar.position.bottom": {
    "icon": "󰁅",
    "label": "Bottom Bar",
    "action": "gran-bar position bottom"
  },
  "appearance.top-bar.position.left": {
    "icon": "󰁍",
    "label": "Left Bar",
    "action": "gran-bar position left"
  },
  "appearance.top-bar.position.right": {
    "icon": "󰁔",
    "label": "Right Bar",
    "action": "gran-bar position right"
  },
