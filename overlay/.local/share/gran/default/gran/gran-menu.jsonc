  "appearance.animations-on": {
    "icon": "󰗘",
    "label": "Animations On",
    "when": "gran-hyprland-toggle-enabled no-animations",
    "action": "gran-toggle-animations"
  },
  "appearance.animations-off": {
    "icon": "󰗘",
    "label": "Animations Off",
    "when": "! gran-hyprland-toggle-enabled no-animations",
    "action": "gran-toggle-animations"
  },
  "trigger.toggle": {
    "icon": "󰔎",
    "label": "Toggle",
    "aliases": [
      "toggle",
      "toggles"
    ]
  },
  "trigger.toggle.idle-lock-on": {
    "icon": "",
    "label": "Stay Awake",
    "when": "[[ ! -f ~/.local/state/gran/indicators/stay-awake ]]",
    "action": "gran-toggle-idle"
  },
  "trigger.toggle.idle-lock-off": {
    "icon": "",
    "label": "Allow Sleep",
    "when": "[[ -f ~/.local/state/gran/indicators/stay-awake ]]",
    "action": "gran-toggle-idle"
  },
  "trigger.toggle.notifications-on": {
    "icon": "󰂛",
    "label": "Notifications On",
    "when": "[[ $(gran-shell notifications isDnd) == on ]]",
    "action": "gran-toggle-notification-silencing"
  },
  "trigger.toggle.notifications-off": {
    "icon": "󰂛",
    "label": "Silence Notifications",
    "when": "[[ $(gran-shell notifications isDnd) != on ]]",
    "action": "gran-toggle-notification-silencing"
  },
  "trigger.toggle.nightlight-on": {
    "icon": "󰔎",
    "label": "Nightlight On",
    "when": "[[ $(gran-toggle-nightlight --status) != *'\"enabled\":true'* ]]",
    "action": "gran-toggle-nightlight"
  },
  "trigger.toggle.nightlight-off": {
    "icon": "󰔎",
    "label": "Nightlight Off",
    "when": "[[ $(gran-toggle-nightlight --status) == *'\"enabled\":true'* ]]",
    "action": "gran-toggle-nightlight"
  },
  "trigger.toggle.screensaver-on": {
    "icon": "󱄄",
    "label": "Screensaver On",
    "when": "gran-toggle-enabled screensaver-off",
    "action": "gran-toggle-screensaver"
  },
  "trigger.toggle.screensaver-off": {
    "icon": "󱄄",
    "label": "Screensaver Off",
    "when": "! gran-toggle-enabled screensaver-off",
    "action": "gran-toggle-screensaver"
  },
  "trigger.toggle.crash-capture-on": {
    "icon": "󱚡",
    "label": "Crash Capture On",
    "when": "gran-toggle-enabled crash-capture-off",
    "action": "gran-toggle-crash-capture"
  },
  "trigger.toggle.crash-capture-off": {
    "icon": "󱚡",
    "label": "Crash Capture Off",
    "when": "! gran-toggle-enabled crash-capture-off",
    "action": "gran-toggle-crash-capture"
  },
