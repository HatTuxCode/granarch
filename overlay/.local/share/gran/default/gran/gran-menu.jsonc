  "appearance.dock": {
    "icon": "󱂩",
    "label": "Dock",
    "when": "[[ $(gran-hyprland-workspace-layout-current) == \"floating\" ]]"
  },
  "appearance.dock.autohide": {
    "icon": "󰈉",
    "label": "Auto-hide Dock",
    "when": "[[ $(gran-dock autohide) == \"off\" ]]",
    "action": "gran-dock autohide on"
  },
  "appearance.dock.always-on": {
    "icon": "󰈈",
    "label": "Always-on Dock",
    "when": "[[ $(gran-dock autohide) == \"on\" ]]",
    "action": "gran-dock autohide off"
  },
  "appearance.dock.position": {
    "icon": "",
    "label": "Dock Position"
  },
  "appearance.dock.position.top": {
    "icon": "󰁝",
    "label": "Top Dock",
    "checked": "[[ $(gran-dock position) == \"top\" ]]",
    "action": "gran-dock position top"
  },
  "appearance.dock.position.bottom": {
    "icon": "󰁅",
    "label": "Bottom Dock",
    "checked": "[[ $(gran-dock position) == \"bottom\" ]]",
    "action": "gran-dock position bottom"
  },
  "appearance.dock.position.left": {
    "icon": "󰁍",
    "label": "Left Dock",
    "checked": "[[ $(gran-dock position) == \"left\" ]]",
    "action": "gran-dock position left"
  },
  "appearance.dock.position.right": {
