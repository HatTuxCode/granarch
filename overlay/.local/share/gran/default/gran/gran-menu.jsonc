  },
  "appearance.windows.transparency.glassy": {
    "icon": "󰂵",
    "label": "Glassy Windows",
    "checked": "[[ $(gran-hyprland-window-transparency) == \"glassy\" ]]",
    "action": "gran-hyprland-window-transparency glassy"
  },
  "appearance.windows.one-window-ratio-on": {
    "icon": "",
    "label": "1-Window Ratio On",
    "when": "! gran-hyprland-toggle-enabled single-window-aspect-ratio",
