#!/usr/bin/env bash
# gran:summary=List the Gran skills installed for Codex and OpenCode
# gran:args=[list]
set -euo pipefail
[[ ${1:-list} == list && $# -le 1 ]] || { echo 'Usage: gran skills [list]' >&2; exit 2; }
for directory in "$HOME"/.agents/skills/gran*; do
  [[ -f $directory/SKILL.md ]] || continue
  printf '%s\t%s\n' "${directory##*/}" "$directory/SKILL.md"
done
