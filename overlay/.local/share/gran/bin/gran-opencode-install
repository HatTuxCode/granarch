#!/usr/bin/env bash
# gran:summary=Install or repair OpenCode using its official release binary
set -euo pipefail
[[ $EUID -ne 0 ]] || { echo 'Execute como usuário comum.' >&2; exit 1; }
# Use the release backend explicitly: npm installations can skip postinstall.
TOOL=aqua:anomalyco/opencode
mise use -g "$TOOL@latest"
mise exec "$TOOL" -- opencode --version
# Only retire the previous request after the replacement successfully runs.
# Keep the old installation available for recovery; no application data is removed.
mise unuse -g --no-prune npm:opencode-ai
mise reshim
mise exec -- opencode --version
# Test the ordinary command too: this is how terminals and launchers invoke it.
opencode --version
