#!/usr/bin/env bash
set -euo pipefail
export GRAN_PATH="$HOME/.local/share/gran"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$GRAN_PATH/bin:$PATH"
export TERMINAL=kitty
export QT_QPA_PLATFORMTHEME=qt6ct QT_STYLE_OVERRIDE=Fusion QT_QUICK_CONTROLS_STYLE=Fusion
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
cleanup() { systemctl --user stop gran-noctalia.service gran-adaptive-power.timer gran-keyboard-idle.service || true; }
trap cleanup EXIT
/usr/bin/start-hyprland -- --config "$HOME/.config/hypr/hyprland.lua" &
compositor_pid=$!
trap 'kill -TERM "$compositor_pid" 2>/dev/null || true' TERM INT
wait "$compositor_pid"
