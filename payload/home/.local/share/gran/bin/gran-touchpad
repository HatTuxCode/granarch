#!/usr/bin/env python3
# gran:summary=Toggle the detected touchpad without assuming a device name
import json
from pathlib import Path
import re
import subprocess
import sys
state=Path.home()/'.local/state/gran/touchpad-disabled'
action=sys.argv[1] if len(sys.argv)>1 else 'toggle'
if action=='restore' and not state.exists():sys.exit(0)
enabled=action=='on' or (action=='toggle' and state.exists())
devices=json.loads(subprocess.check_output(['hyprctl','-j','devices'],text=True))
for device in devices.get('mice',[]):
    name=device.get('name','')
    if 'touchpad' not in name.lower() or not re.fullmatch(r'[a-zA-Z0-9:_-]+',name):continue
    subprocess.run(['hyprctl','eval','hl.device({ name = '+json.dumps(name)+', enabled = '+('true' if enabled else 'false')+' })'],check=True)
    state.parent.mkdir(parents=True,exist_ok=True)
    if enabled:state.unlink(missing_ok=True)
    else:state.touch()
