#!/usr/bin/env bash
set -euo pipefail
folder="$(xdg-user-dir PICTURES)/Screenshots"
mkdir -p "$folder"
file="$folder/$(date +%Y-%m-%d_%H-%M-%S-%N).png"
if [[ "${1:-}" == region ]]; then
 geometry="$(slurp)" || exit 0
 grim -g "$geometry" "$file"
else
 grim "$file"
fi
wl-copy --type image/png < "$file"
command -v notify-send >/dev/null && notify-send 'Captura de tela salva' "$file" || true
