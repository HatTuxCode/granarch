#!/usr/bin/env python3
"""Open the native Zen package, retaining an existing default browser profile."""
import configparser,os,sys
from pathlib import Path
home=Path.home();chosen=None
inis=[p for p in (home/'.zen/profiles.ini',home/'.config/zen/profiles.ini') if p.is_file()]
for ini in sorted(inis,key=lambda p:p.stat().st_mtime,reverse=True):
    config=configparser.ConfigParser(interpolation=None)
    config.read(ini)
    defaults=[config.get(section,'Default') for section in config.sections() if section.startswith('Install') and config.has_option(section,'Default')]
    for value in reversed(defaults):
        path=Path(value);path=path if path.is_absolute() else ini.parent/path
        if path.is_dir():chosen=path;break
    if chosen:break
    for section in config.sections():
        if section.startswith('Profile') and config.getboolean(section,'Default',fallback=False):
            value=config.get(section,'Path',fallback='')
            if value:
                path=Path(value)
                if config.getboolean(section,'IsRelative',fallback=True):path=ini.parent/path
                if path.is_dir():chosen=path;break
    if chosen:break
os.environ['MOZ_ENABLE_WAYLAND']='1'
args=['/usr/bin/zen-browser']
if chosen and not any(a in sys.argv[1:] for a in ('-P','--profile','-profile','--ProfileManager')):args+=['--profile',str(chosen)]
os.execv(args[0],args+sys.argv[1:])
