#!/usr/bin/env python3
"""Use checkupdates' separate database; never leave pacman partially synchronized."""
import fcntl, json, subprocess, sys, time
from pathlib import Path
state=Path.home()/'.cache/gran'; state.mkdir(parents=True,exist_ok=True)
with (state/'updates.lock').open('w') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    cache=state/'updates.json'
    if '--refresh' not in sys.argv and cache.exists() and time.time()-cache.stat().st_mtime<3600:
        print(json.loads(cache.read_text())['count']); sys.exit(0)
    result=subprocess.run(['checkupdates'],capture_output=True,text=True,timeout=180)
    if result.returncode not in (0,2): sys.exit(result.stderr or 'Falha ao consultar atualizações')
    count=len(result.stdout.splitlines())
    temporary=cache.with_suffix('.new'); temporary.write_text(json.dumps({'count':count})); temporary.replace(cache)
    print(count)
