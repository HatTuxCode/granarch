[Unit]
Description=Sync GranHat browser appearance policies
ConditionPathExists=@HOME@/.local/state/gran/chromium-color.json
[Service]
Type=oneshot
TimeoutStartSec=10
ExecStart=/usr/local/libexec/gran-browser-theme-policy
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/chromium/policies/managed
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
