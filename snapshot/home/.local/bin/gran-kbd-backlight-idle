#!/bin/bash

# gran:summary=Turn the keyboard backlight off on idle (battery only) and restore it on activity

set -euo pipefail

STATE_FILE="$HOME/.local/state/gran/indicators/kbd-backlight-saved"
DEFAULT_FILE="$HOME/.local/state/gran/indicators/kbd-backlight-default"
DEVICE="asus::kbd_backlight"

mkdir -p "$(dirname "$STATE_FILE")"

is_ac() {
  for src in /sys/class/power_supply/ADP1/online /sys/class/power_supply/AC0/online /sys/class/power_supply/AC*/online; do
    [[ -f "$src" ]] && [[ "$(<"$src")" == "1" ]] && return 0
  done
  return 1
}

case "${1:-}" in
  idle)
    if is_ac; then
      rm -f "$STATE_FILE"
      exit 0
    fi
    current=$(brightnessctl -d "$DEVICE" get 2>/dev/null || echo 0)
    if [[ ! -f "$STATE_FILE" ]] && [[ "$current" -gt 0 ]]; then
      printf '%s\n' "$current" > "$STATE_FILE"
    fi
    brightnessctl -d "$DEVICE" set 0 >/dev/null 2>&1
    ;;
  active)
    if [[ -f "$STATE_FILE" ]]; then
      v=$(tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || echo 0)
      current=$(brightnessctl -d "$DEVICE" get 2>/dev/null || echo 0)
      if [[ -n "$v" ]] && [[ "$v" =~ ^[0-9]+$ ]] && [[ "$v" -gt "$current" ]]; then
        brightnessctl -d "$DEVICE" set "$v" >/dev/null 2>&1
      fi
      rm -f "$STATE_FILE"
    elif [[ "$(brightnessctl -d "$DEVICE" get 2>/dev/null || echo 0)" -eq 0 ]] \
        && [[ -f "$DEFAULT_FILE" ]]; then
      v=$(tr -d '[:space:]' < "$DEFAULT_FILE" 2>/dev/null || echo 1)
      [[ "$v" =~ ^[0-9]+$ ]] && brightnessctl -d "$DEVICE" set "$v" >/dev/null 2>&1
    fi
    ;;
esac