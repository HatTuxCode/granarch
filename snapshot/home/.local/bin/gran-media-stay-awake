#!/bin/bash

# gran:summary=Keep the screen awake while media is playing (video/audio)

set -euo pipefail

STATE_DIR="$HOME/.local/state/gran/indicators"
STATE_FILE="$STATE_DIR/stay-awake"
MEDIA_MARKER="$STATE_DIR/watchdog-media-awake"

media_playing() {
  # MPRIS players reporting active playback (playerctl, if installed).
  if command -v playerctl >/dev/null 2>&1; then
    if playerctl --all-players status 2>/dev/null | grep -q Playing; then
      return 0
    fi
  fi

  # PipeWire running audio playback streams (excluding virtual/internal nodes).
  if pw-dump -N 2>/dev/null | jq -e '
    [.[] | select(.type == "PipeWire:Interface:Node"
      and (.info.props["media.class"] | strings | startswith("Stream/Output/Audio"))
      and .info.state == "running"
      and (.info.props["node.name"] | strings | startswith("gran.") | not))] | length > 0' >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

if media_playing; then
  mkdir -p "$STATE_DIR"
  touch "$STATE_FILE"
  touch "$MEDIA_MARKER"
else
  # Only remove the stay-awake file if this watchdog had created it for media,
  # so a manual stay-awake toggle (SUPER+CTRL+I) is not clobbered.
  if [[ -f "$MEDIA_MARKER" ]]; then
    rm -f "$STATE_FILE"
    rm -f "$MEDIA_MARKER"
  fi
fi