#!/bin/bash

# gran:summary=Launch the default coding agent with a prompt
# gran:args=[--inline] <prompt...>
# gran:examples=gran agent prompt "Review this project"

# Prompts live here rather than on `gran agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: gran agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec gran-agent "${inline[@]}" --prompt "$*"
