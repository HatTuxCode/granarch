#!/bin/bash

# gran:summary=List available themes
# gran:examples=gran theme list | gran theme set "Tokyo Night"

{
  find ~/.config/gran/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$GRAN_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
