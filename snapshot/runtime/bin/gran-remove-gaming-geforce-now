#!/bin/bash

# gran:summary=Remove the GeForce NOW Flatpak app and its data.
# gran:group=remove
# gran:name=gaming geforce-now

set -e

if gran-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
