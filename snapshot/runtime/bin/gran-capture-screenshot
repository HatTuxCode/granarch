#!/bin/bash

# gran:summary=Take a screenshot
# gran:group=capture
# gran:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# gran:examples=gran screenshot | gran capture screenshot region
# gran:aliases=gran screenshot

if [[ -n ${GRAN_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$GRAN_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   gran-i18n capture.screenshotSaved, gran-i18n capture.screenshotSavedCopied,
#   gran-i18n capture.screenshotOpen, gran-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
