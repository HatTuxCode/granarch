#!/bin/bash

# gran:summary=Launch or focus on a given web app identified by the window-pattern.
# gran:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: gran-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="gran-launch-webapp $@"

exec gran-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
