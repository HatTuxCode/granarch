#!/bin/bash

# gran:summary=Disable a shell plugin
# gran:group=plugin
# gran:args=<id>

set -euo pipefail

fail() {
  echo "gran-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: gran plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(gran-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: gran-shell shell rescanPlugins"

echo "Disabled $id"
