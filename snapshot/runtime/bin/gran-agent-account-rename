#!/bin/bash

# gran:summary=Rename a Claude, Codex, or Grok subscription account
# gran:args=[claude|codex|grok] <account> <name>
# gran:examples=gran agent account rename primary Hey | gran agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `gran agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(gran-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || (( $# < 3 )); then
  echo "Usage: gran-agent-account-rename [claude|codex|grok] <account> <name>" >&2
  exit 1
fi

account=$(gran-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: gran agent account use $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
gran-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
