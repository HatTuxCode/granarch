#!/bin/bash

# gran:summary=Send the low battery warning notification and run battery-low hooks.
# gran:args=<percentage>
# gran:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: gran-battery-low <percentage>" >&2
  exit 1
fi

level=$1

gran-notification-send -g 󱐋 -u normal "$(gran-i18n battery.lowTitle)" "$(gran-i18n battery.lowBody "$level")" -i battery-caution -t 30000
gran-hook battery-low "$level"
