#!/bin/bash

# gran:summary=Remove Steam and all of its game libraries, configs, and caches.
# gran:requires-sudo=true

set -e

gran-lifecycle-dispatch pre-remove steam
gran-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
