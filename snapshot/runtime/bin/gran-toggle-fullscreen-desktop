#!/bin/bash

# gran:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# gran:args=[toggle|on|off]
# gran:examples=gran toggle fullscreen desktop | gran toggle fullscreen desktop off | gran toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if gran-toggle-enabled bar-off && gran-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: gran-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

gran-toggle-bar "$ACTION"
gran-hyprland-toggle window-no-gaps "$ACTION"
