#!/bin/bash

# gran:summary=Get or set the default dictation backend
# gran:args=[backend]
# gran:examples=gran default dictation | gran default dictation superwhisper

if (($# > 1)); then
  echo "Usage: gran default dictation [backend]" >&2
  exit 1
fi

if (($# == 0)); then
  config="${XDG_CONFIG_HOME:-$HOME/.config}/gran/defaults/dictation"
  if [[ ! -s $config ]]; then
    echo "No dictation backend configured. Select one in Setup > Defaults > Dictation." >&2
    exit 1
  fi
  read -r backend < "$config"
else
  backend=$1
fi

if [[ ! $backend =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid dictation backend: $backend" >&2
  exit 1
fi

if (($# == 0)); then
  echo "$backend"
else
  installer="gran-install-dictation-$backend"
  if gran-cmd-missing "$installer"; then
    echo "No installer available for dictation backend: $backend" >&2
    exit 1
  fi
  gran-launch-floating-terminal-with-presentation "$installer"
fi
