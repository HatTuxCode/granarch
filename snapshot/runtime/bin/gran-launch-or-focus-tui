#!/bin/bash

# gran:summary=Launch a TUI or focus an existing terminal window for it
# gran:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.gran.$(basename "$1")"
fi

LAUNCH_COMMAND="gran-launch-tui $@"

exec gran-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
