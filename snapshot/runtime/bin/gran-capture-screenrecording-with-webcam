#!/bin/bash

# gran:summary=Pick a webcam and start a screen recording with it
# gran:examples=gran capture screenrecording-with-webcam

mapfile -t devices < <(gran-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  gran-notification-send "$(gran-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(gran-menu-select "$(gran-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec gran-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
